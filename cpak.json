{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Go SDK",
  "description": "Go compiler and tools for cpak development environments.",
  "version": "1.27.0",
  "image": "ghcr.io/containerpak/sdk-go@sha256:16488abb58076e1317972bccae08a8850b17e134baa9ee0cf7ccedea8781d5da",
  "binaries": [
    "/usr/local/bin/go",
    "/usr/local/bin/gofmt"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "go",
    "slot": "sdk.go",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/local/bin"
      ],
      "environment": [
        "GOROOT=/usr/local"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filePicker": {},
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
