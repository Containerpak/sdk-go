{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
  "manifest_version": "2.0",
  "name": "Go SDK",
  "description": "Go compiler and tools for cpak development environments.",
  "version": "1.26.5",
  "image": "ghcr.io/containerpak/sdk-go:main",
  "binaries": [
    "/usr/local/bin/go",
    "/usr/local/bin/gofmt"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "network": true
  }
}
